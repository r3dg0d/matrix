#compdef matrix

autoload -U is-at-least

_matrix() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-s+[Fall speed multiplier (0.05–8)]:FACTOR:_default' \
'--speed=[Fall speed multiplier (0.05–8)]:FACTOR:_default' \
'-d+[Column density as fraction of width (0.05–1)]:FRAC:_default' \
'--density=[Column density as fraction of width (0.05–1)]:FRAC:_default' \
'-f+[Frame rate cap]:FPS:_default' \
'--fps=[Frame rate cap]:FPS:_default' \
'-c+[Color palette]:NAME:_default' \
'--color=[Color palette]:NAME:_default' \
'-p+[Named preset]:NAME:_default' \
'--preset=[Named preset]:NAME:_default' \
'--charset=[Glyph charset]:NAME:_default' \
'--chars=[Custom glyph string (overrides --charset)]:CHARS:_default' \
'--trail=[Trail length factor (0.1–1)]:FRAC:_default' \
'--truecolor=[Force truecolor on/off]::BOOL:(true false)' \
'--list-presets[List available presets and exit]' \
'--list-charsets[List available charsets and exit]' \
'--list-palettes[List available palettes and exit]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_matrix_commands" \
"*::: :->matrix" \
&& ret=0
    case $state in
    (matrix)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:matrix-command-$line[1]:"
        case $line[1] in
            (completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_matrix__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:matrix-help-command-$line[1]:"
        case $line[1] in
            (completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_matrix_commands] )) ||
_matrix_commands() {
    local commands; commands=(
'completions:Generate shell completions to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'matrix commands' commands "$@"
}
(( $+functions[_matrix__subcmd__completions_commands] )) ||
_matrix__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'matrix completions commands' commands "$@"
}
(( $+functions[_matrix__subcmd__help_commands] )) ||
_matrix__subcmd__help_commands() {
    local commands; commands=(
'completions:Generate shell completions to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'matrix help commands' commands "$@"
}
(( $+functions[_matrix__subcmd__help__subcmd__completions_commands] )) ||
_matrix__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'matrix help completions commands' commands "$@"
}
(( $+functions[_matrix__subcmd__help__subcmd__help_commands] )) ||
_matrix__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'matrix help help commands' commands "$@"
}

if [ "$funcstack[1]" = "_matrix" ]; then
    _matrix "$@"
else
    compdef _matrix matrix
fi
